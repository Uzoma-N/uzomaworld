:Instagram rdf:type owl:Class ;
           rdfs:subClassOf :Socials .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume#LinkedIn
:LinkedIn rdf:type owl:Class ;
          rdfs:subClassOf :Socials .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume#Service
:Service rdf:type owl:Class .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume#Snapchat
:Snapchat rdf:type owl:Class ;
          rdfs:subClassOf :Socials .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume#Socials
:Socials rdf:type owl:Class .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume#Twitter
:Twitter rdf:type owl:Class ;
         rdfs:subClassOf :Socials .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/Certification
:Certification rdf:type owl:Class ;
               rdfs:label "Certification"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/City
:City rdf:type owl:Class ;
      rdfs:label "City"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/Country
:Country rdf:type owl:Class ;
         rdfs:label "Country"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/Course
:Course rdf:type owl:Class ;
        rdfs:label "Course of Study"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/Degree
:Degree rdf:type owl:Class .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/DigitalSkill
:DigitalSkill rdf:type owl:Class ;
              rdfs:subClassOf :Skills ;
              rdfs:label "Digital Skill"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/Duties
:Duties rdf:type owl:Class ;
        rdfs:label "Duties"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/Education
:Education rdf:type owl:Class ;
           rdfs:label "Education"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/Entry_type
:Entry_type rdf:type owl:Class ;
            rdfs:label "the type of instance"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/LanguageSkill
:LanguageSkill rdf:type owl:Class ;
               rdfs:subClassOf :Skills ;
               rdfs:label "Language Skill"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/Skills
:Skills rdf:type owl:Class ;
        rdfs:label "Skills"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/SoftSkill
:SoftSkill rdf:type owl:Class ;
           rdfs:subClassOf :Skills ;
           rdfs:label "Soft Skill"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/WorkExperience
:WorkExperience rdf:type owl:Class ;
                rdfs:label "Work Experience"@en .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Agent
foaf:Agent rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Organization
foaf:Organization rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Project
foaf:Project rdf:type owl:Class .



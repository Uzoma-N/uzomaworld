@prefix : <http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/> .

<http://www.semanticweb.org/uzoma/ontologies/2025/9/resume> rdf:type owl:Ontology ;
                                                             owl:imports foaf: .

#################################################################
#    Annotation properties
#################################################################

###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/displayName
:displayName rdf:type owl:AnnotationProperty ;
             rdfs:label "displayName"@en .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdfs:range rdfs:Literal ;
             rdfs:domain foaf:Project .


###  http://xmlns.com/foaf/0.1/birthday
foaf:birthday rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/firstName
foaf:firstName rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/lastName
foaf:lastName rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/status
foaf:status rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume#hasProject
:hasProject rdf:type owl:ObjectProperty ;
            rdfs:domain foaf:Person ;
            rdfs:range foaf:Project ;
            rdfs:label "has project"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume#hasSocial
:hasSocial rdf:type owl:ObjectProperty ;
           rdfs:domain foaf:Person ;
           rdfs:range :Socials ;
           rdfs:label "has social"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume#provideService
:provideService rdf:type owl:ObjectProperty ;
                rdfs:domain foaf:Person ;
                rdfs:range :Service ;
                rdfs:label "provides services"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/degreeLevel
:degreeLevel rdf:type owl:ObjectProperty ;
             rdfs:domain :Course ;
             rdfs:range :Degree ;
             rdfs:label "at degree level"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/doneAt
:doneAt rdf:type owl:ObjectProperty ;
        rdfs:domain :Education ,
                    :WorkExperience ;
        rdfs:range foaf:Organization ;
        rdfs:label "done at"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasAchievement
:hasAchievement rdf:type owl:ObjectProperty ;
                rdfs:domain foaf:Person ;
                rdfs:range :Certification ;
                rdfs:label "has achieved a certificate"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasCategory
:hasCategory rdf:type owl:ObjectProperty ;
             rdfs:domain :Certification ,
                         :Skills ,
                         :WorkExperience ,
                         foaf:Project ;
             rdfs:range :Entry_type ;
             rdfs:label "is categorized as"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasCourse
:hasCourse rdf:type owl:ObjectProperty ;
           rdfs:domain foaf:Organization ;
           rdfs:range :Course ;
           rdfs:label "provides course"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasDuty
:hasDuty rdf:type owl:ObjectProperty ;
         rdfs:domain :WorkExperience ,
                     foaf:Project ;
         rdfs:range :Duties ;
         rdfs:label "has following duties"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasEducation
:hasEducation rdf:type owl:ObjectProperty ;
              rdfs:domain foaf:Person ;
              rdfs:range :Education ;
              rdfs:label "has education"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasExperience
:hasExperience rdf:type owl:ObjectProperty ;
               rdfs:domain foaf:Person ;
               rdfs:range :WorkExperience ;
               rdfs:label "has experience"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasSkill
:hasSkill rdf:type owl:ObjectProperty ;
          rdfs:domain foaf:Person ;
          rdfs:range :Skills ;
          rdfs:label "is skilled at"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/locatedIn
:locatedIn rdf:type owl:ObjectProperty ;
           rdfs:domain :City ,
                       foaf:Organization ;
           rdfs:range :City ,
                      :Country ;
           rdfs:label "located in"@en .


###  http://xmlns.com/foaf/0.1/theme
foaf:theme rdf:type owl:ObjectProperty ;
           rdfs:domain foaf:Project ;
           rdfs:range skos:Concept ;
           rdfs:label "is classified as"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:DatatypeProperty ;
               rdfs:domain :Duties ;
               rdfs:range rdfs:Literal .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/endDate
:endDate rdf:type owl:DatatypeProperty ;
         rdfs:domain :Certification ,
                     :Education ,
                     :WorkExperience ;
         rdfs:range xsd:dateTime ;
         rdfs:label "endDate"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasAddress
:hasAddress rdf:type owl:DatatypeProperty ;
            rdfs:domain foaf:Agent ;
            rdfs:range rdfs:Literal ;
            rdfs:label "hasAddress"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasEmail
:hasEmail rdf:type owl:DatatypeProperty ;
          rdfs:domain foaf:Person ;
          rdfs:range rdfs:Literal ;
          rdfs:label "hasEmail"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasGrade
:hasGrade rdf:type owl:DatatypeProperty ;
          rdfs:domain :Degree ;
          rdfs:range rdfs:Literal ;
          rdfs:label "hasGrade"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasGradeValue
:hasGradeValue rdf:type owl:DatatypeProperty ;
               rdfs:domain :Degree ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasLink
:hasLink rdf:type owl:DatatypeProperty ;
         rdfs:domain :Certification .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasPercentage
:hasPercentage rdf:type owl:DatatypeProperty ;
               rdfs:domain :DigitalSkill ,
                           :LanguageSkill ,
                           :SoftSkill ;
               rdfs:label "hasPercentage"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/hasPhone
:hasPhone rdf:type owl:DatatypeProperty ;
          rdfs:domain foaf:Person ;
          rdfs:range rdfs:Literal ;
          rdfs:label "hasPhone"@en .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume/startDate
:startDate rdf:type owl:DatatypeProperty ;
           rdfs:domain :Education ,
                       :WorkExperience ;
           rdfs:range xsd:dateTime ;
           rdfs:label "startDate"@en .


###  http://xmlns.com/foaf/0.1/title
foaf:title rdf:type owl:DatatypeProperty ;
           rdfs:domain :Certification ,
                       :WorkExperience ,
                       foaf:Project ;
           rdfs:range rdfs:Literal .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume#Facebook
:Facebook rdf:type owl:Class ;
          rdfs:subClassOf :Socials .


###  http://www.semanticweb.org/uzoma/ontologies/2025/9/resume#Github
:Github rdf:type owl:Class ;
        rdfs:subClassOf :Socials .


